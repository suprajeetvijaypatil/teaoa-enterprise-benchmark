{
  "workflow_id": "PROC-001",
  "version": "1.0",
  "domain": "procurement",
  "scenario": "Conflicting supplier information",
  "task_instruction": "Evaluate supplier SUP-2001. Detect conflicting bank-account information and route the case for human approval.",
  "dataset": "benchmark/datasets/PROC-001.csv",
  "prompt": "benchmark/prompts/PROC-001.txt",
  "ground_truth": "benchmark/ground_truth/PROC-001.json",
  "steps": [
    "retrieve_supplier",
    "compare_supplier_records",
    "detect_conflict",
    "block_automatic_update",
    "route_for_approval"
